					"to": "name[length] = 'x';"
				}
			]
		},
		{
			"name": "NAME: a name with no end marker in its chunk is let through",
			"changes": [
				{
					"file": "3dc/avp/win95/hierplace.cpp",
					"from": "if (name_length < 0)",
					"to": "if (false)"
				}
			]
		},
		{
