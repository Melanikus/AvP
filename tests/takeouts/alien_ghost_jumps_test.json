{
	"copy": ["3dc", "tests"],
	"rows": [
		{ "name": "a down at 45 degrees counts as a floor's",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "if (downY > kAlienGhostCos45)", "to": "if (downY >= kAlienGhostCos45)" }] },
		{ "name": "a down at 45 degrees from straight up counts as a ceiling's",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "if (downY < -kAlienGhostCos45)", "to": "if (downY <= -kAlienGhostCos45)" }] },
		{ "name": "a floor is called a ceiling",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "return kAlienGhostOnFloor;", "to": "return kAlienGhostOnCeiling;" }] },
		{ "name": "a jump is squared in 32 bits",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "(double)((long long)dx * dx)", "to": "(double)(dx * dx)" }] },
		{ "name": "a jump is cut down, not rounded",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "sqrt(squared) + 0.5", "to": "sqrt(squared)" }] },
		{ "name": "two downs are only off when they point more than 90 degrees apart",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "return dot < (long long)kAlienGhostCos45 * 65536;", "to": "return dot < 0;" }] },
		{ "name": "a surface past the end of the list is counted",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "if (surface < 0 || surface >= kAlienGhostSurfaces)", "to": "if (surface < 0)" }] },
		{ "name": "the largest jump isn't kept",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "jumps->mostMm[surface] = jumpMm;", "to": "" }] },
		{ "name": "a down that's off isn't counted",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "jumps->downOff++;", "to": "" }] },
		{ "name": "a count doesn't remember when it started",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "jumps->startMs = nowMs;", "to": "" }] },
		{ "name": "a line is due by adding to the start, which goes wrong as the clock wraps",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "nowMs - jumps.startMs >= kAlienGhostJumpsEveryMs", "to": "nowMs >= jumps.startMs + kAlienGhostJumpsEveryMs" }] },
		{ "name": "the seconds are cut down, not rounded",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "(nowMs - jumps.startMs + 500) / 1000", "to": "(nowMs - jumps.startMs) / 1000" }] },
		{ "name": "the average is cut down, not rounded",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "(jumps.totalMm[s] + jumps.news[s] / 2) / jumps.news[s]", "to": "jumps.totalMm[s] / jumps.news[s]" }] },
		{ "name": "the line's words change",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "on average and %u mm at most", "to": "on average and %u mm most" }] },
		{ "name": "the line leaves out the crawling",
			"changes": [{ "file": "3dc/alien_ghost_jumps.h", "from": "if (jumps.crawling > 0)", "to": "if (false)" }] },
		{ "name": "the game doesn't count the jump",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "NoteAlienGhostJump(sbPtr, &position, &orientation, !messagePtr->standard_gravity);", "to": "" }] },
		{ "name": "a far ghost's jump is counted",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "if (!ghostData || !dynPtr || ghostData->onlyValidFar)", "to": "if (!ghostData || !dynPtr)" }] },
		{ "name": "the news's down is taken from the wrong part of its turn",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "int const newsDown[3] = { turn.mat12, turn.mat22, turn.mat32 };", "to": "int const newsDown[3] = { turn.mat21, turn.mat22, turn.mat23 };" }] },
		{ "name": "the surface is taken from the wrong part of the down",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "AlienGhost_SurfaceOf(newsDown[1])", "to": "AlienGhost_SurfaceOf(newsDown[2])" }] },
		{ "name": "the jump is measured from where the ghost was a frame ago",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "newsPlace->vx - dynPtr->Position.vx", "to": "newsPlace->vx - dynPtr->PrevPosition.vx" }] },
		{ "name": "a line that's due isn't written",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "if (AlienGhostJumps_LineIsDue(alienGhostJumps, now))", "to": "if (false)" }] },
		{ "name": "writing the line doesn't start the count again",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "alienGhostJumps = AlienGhostJumps();", "to": "" }] },
		{ "name": "the end of a network game loses what's left",
			"changes": [{ "file": "3dc/avp/win95/pldnet.cpp", "from": "\t// What the last few seconds counted about the aliens' ghosts, so it isn't lost with the game\n\tWriteAlienGhostJumps();\n", "to": "" }] }
	]
}
