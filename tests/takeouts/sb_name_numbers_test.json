			"name": "SOURCE: the check counts the thing being named as alive",
			"changes": [
				{
					"file": "3dc/avp/strategy_def.cpp",
					"from": "if (other && other != self && memcmp(",
					"to": "if (other && memcmp("
				}
			]
		},
