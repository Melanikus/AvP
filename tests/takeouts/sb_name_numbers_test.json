		{
			"name": "the count never goes back to 1",
			"changes": [
				{
					"file": "3dc/avp/sb_name_numbers.h",
					"from": "number = (number >= kSBNameMostNumber) ? 1 : number + 1;",
					"to": "number = number + 1;"
				}
			]
		},
		{
			"name": "a number out of range isn't started again from 1",
			"changes": [
				{
					"file": "3dc/avp/sb_name_numbers.h",
					"from": "number = (number >= kSBNameMostNumber) ? 1 : number + 1;",
					"to": "number = (number == kSBNameMostNumber) ? 1 : number + 1;"
				}
			]
		},
		{
			"name": "a number something alive has is used again",
