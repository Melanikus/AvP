			"changes": [
				{
					"file": "3dc/avp/strategy_def.cpp",
					"from": "\tsbPtr->SBname[4] = (char)(IncrementalSBname & 0xff);\n\tsbPtr->SBname[5] = (char)((IncrementalSBname >> 8) & 0xff);\n\tsbPtr->SBname[6] = (char)((IncrementalSBname >> 16) & 0xff);\n",
					"to": "\t*((int *)&sbPtr->SBname[4])=IncrementalSBname;\n"
				}
			]
