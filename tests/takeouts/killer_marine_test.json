	"rows": [
		{
			"name": "a fingerprint that differs only in its last byte is the same",
			"changes": [
				{
					"file": "3dc/avp/killer_marine.h",
					"from": "for (size_t i = 0; i < kKillerMarineFingerprintBytes; i++)\n\t{\n\t\tdifferences |=",
					"to": "for (size_t i = 0; i < kKillerMarineFingerprintBytes - 1; i++)\n\t{\n\t\tdifferences |="
				}
			]
		},
		{
			"name": "only the last byte of a fingerprint is compared",
			"changes": [
				{
					"file": "3dc/avp/killer_marine.h",
					"from": "differences |= static_cast<uint8_t>(a[i] ^ b[i]);",
					"to": "differences = static_cast<uint8_t>(a[i] ^ b[i]);"
				}
			]
		},
		{
			"name": "every fingerprint is the same as every other: the mode is on when it should be off",
			"changes": [
				{
					"file": "3dc/avp/killer_marine.h",
					"from": "return differences == 0;",
					"to": "return true;"
				}
			]
		},
		{
			"name": "no fingerprint is the same as any other: the mode is off when it should be on",
			"changes": [
				{
					"file": "3dc/avp/killer_marine.h",
					"from": "return differences == 0;",
					"to": "return false;"
				}
			]
		},
		{
			"name": "a fingerprint of zeros but its first byte is nobody",
			"changes": [
				{
