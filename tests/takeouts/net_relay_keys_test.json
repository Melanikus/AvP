{
	"copy": [
		"3dc",
		"tests"
	],
	"rows": [
		{
			"name": "the fingerprint has no words in front of the keys",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "{ reinterpret_cast<const uint8_t *>(kNetRelayKeysWords), sizeof(kNetRelayKeysWords) - 1 },",
					"to": "{ reinterpret_cast<const uint8_t *>(kNetRelayKeysWords), 0 },"
				}
			]
		},
		{
			"name": "the fingerprint takes the words' 0 too",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "{ reinterpret_cast<const uint8_t *>(kNetRelayKeysWords), sizeof(kNetRelayKeysWords) - 1 },",
					"to": "{ reinterpret_cast<const uint8_t *>(kNetRelayKeysWords), sizeof(kNetRelayKeysWords) },"
				}
			]
		},
		{
			"name": "the ML-KEM key isn't in the fingerprint",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "{ keys->kem, kNetPqKemPublicBytes },",
					"to": "{ keys->kem, 0 },"
				}
			]
		},
		{
			"name": "the P-384 key isn't in the fingerprint",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "{ keys->p384, kNetCryptoP384PublicBytes },",
					"to": "{ keys->p384, 0 },"
				}
			]
		},
		{
			"name": "the check looks at the first byte of the fingerprint only",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "for (size_t i = 0; i < kNetRelayKeysFingerprintBytes; i++)\n\t{\n\t\tdiffer |=",
					"to": "for (size_t i = 0; i < 1; i++)\n\t{\n\t\tdiffer |="
				}
			]
		},
		{
			"name": "a setting's region isn't checked",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "if (!RelayList_IsRegion(named) || !NetIdentity_FingerprintFromHex(colon + 1, read))",
					"to": "if (!NetIdentity_FingerprintFromHex(colon + 1, read))"
				}
			]
		},
		{
			"name": "a refused setting leaves what was there",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "\tregion[0] = '\\0';\n\tmemset(fingerprint, 0, kNetRelayKeysFingerprintBytes);\n\n\tif (!setting)",
					"to": "\tif (!setting)"
				}
			]
		},
		{
			"name": "a setting with nothing before its colon is taken",
			"changes": [
				{
					"file": "3dc/net_relay_keys.h",
					"from": "if (regionLetters == 0 || regionLetters > kRelayListRegionLetters)",
					"to": "if (regionLetters > kRelayListRegionLetters)"
				}
			]
		}
	]
}
