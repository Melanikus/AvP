	"rows": [
		{ "name": "the glow starts somewhere else", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelGlowAsBuilt = 0.25;", "to": "double const kPixelGlowAsBuilt = 0.5;" } ] },
		{ "name": "the curve starts somewhere else", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelCurveAsBuilt = 1.0;", "to": "double const kPixelCurveAsBuilt = 1.5;" } ] },
		{ "name": "the level starts somewhere else", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelLevelAsBuilt = 1.0;", "to": "double const kPixelLevelAsBuilt = 0.5;" } ] },
		{ "name": "the numbers start out of step with what they go back to", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "static double now[kPixelLookNumbers] = { kPixelGlowAsBuilt,", "to": "static double now[kPixelLookNumbers] = { 0.5," } ] },
		{ "name": "a number over the most is taken", "changes": [ { "file": "3dc/pixel_look.cpp", "from": " || number > kMost[which])", "to": ")" } ] },
		{ "name": "a number under the fewest is taken", "changes": [ { "file": "3dc/pixel_look.cpp", "from": " || number < kFewest[which] ||", "to": " ||" } ] },
		{ "name": "anything at all is read as a number", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "if (!ReadPlainNumber(words, length, &number) ||", "to": "ReadPlainNumber(words, length, &number);\n\n\tif (" } ] },
		{ "name": "a good number isn't kept", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "\tnow[which] = number;\n", "to": "" } ] },
		{ "name": "the most for the glow is too high", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelGlowMost = 1.0;", "to": "double const kPixelGlowMost = 2.0;" } ] },
		{ "name": "the fewest for the curve is too low", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelCurveFewest = 0.25;", "to": "double const kPixelCurveFewest = 0.01;" } ] },
		{ "name": "the most for the level is too high", "changes": [ { "file": "3dc/pixel_look.h", "from": "double const kPixelLevelMost = 2.0;", "to": "double const kPixelLevelMost = 4.0;" } ] },
		{ "name": "putting back forgets the numbers", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "\t\tnow[i] = kAsBuilt[i];\n", "to": "" } ] },
		{ "name": "putting back never says it changed anything", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "wasChanged = wasChanged || now[i] != kAsBuilt[i];", "to": "wasChanged = false;" } ] },
		{ "name": "putting back only notices the first number", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "for (int i = 0; i < kPixelLookNumbers; i++)\n\t{\n\t\twasChanged", "to": "for (int i = 0; i < 1; i++)\n\t{\n\t\twasChanged" } ] },
		{ "name": "the shader gets the numbers in another order", "changes": [ { "file": "3dc/pixel_look.cpp", "from": "four[i] = (float)now[i];", "to": "four[i] = (float)now[(i + 1) % kPixelLookNumbers];" } ] },
		{ "name": "SOURCE: the console doesn't have PIXELGLOW", "changes": [ { "file": "3dc/avp/game_commands.cpp", "from": "ConsoleCommand::Make(\"PIXELGLOW\",", "to": "ConsoleCommand::Make(\"PIXELGLOWS\"," } ] },
		{ "name": "SOURCE: the console doesn't have PIXELCURVE", "changes": [ { "file": "3dc/avp/game_commands.cpp", "from": "ConsoleCommand::Make(\"PIXELCURVE\",", "to": "ConsoleCommand::Make(\"PIXELCURVES\"," } ] },
		{ "name": "SOURCE: the console doesn't have PIXELLEVEL", "changes": [ { "file": "3dc/avp/game_commands.cpp", "from": "ConsoleCommand::Make(\"PIXELLEVEL\",", "to": "ConsoleCommand::Make(\"PIXELLEVELS\"," } ] },
		{ "name": "SOURCE: a word doesn't need -dev", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "\tif (!ReliefToolsCanAct(name))\n\t{\n\t\treturn;\n\t}\n\n\tchar const *start", "to": "\tchar const *start" } ] },
		{ "name": "SOURCE: a word goes on when it can't act", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "\tif (!ReliefToolsCanAct(name))\n\t{\n\t\treturn;\n\t}\n\n\tchar const *start", "to": "\tif (!ReliefToolsCanAct(name))\n\t{\n\t}\n\n\tchar const *start" } ] },
		{ "name": "SOURCE: a word with no number is read as a number", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "if (length > 0 && !PixelLook_FromWords(which, start, (unsigned int)length))", "to": "if (!PixelLook_FromWords(which, start, (unsigned int)length))" } ] },
		{ "name": "SOURCE: a number it can't take goes on anyway", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "\t\tSaySwitch(refused);\n\t\treturn;", "to": "\t\tSaySwitch(refused);" } ] },
		{ "name": "SOURCE: a word doesn't say what the number is", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "\"%s IS %.2f\", name, PixelLook_Now(which)", "to": "\"%s IS SET\", name" } ] },
		{ "name": "SOURCE: PIXELGLOW changes the wrong number", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "PixelLookCommand(kPixelLookGlow,", "to": "PixelLookCommand(kPixelLookCurve," } ] },
		{ "name": "SOURCE: PIXELCURVE changes the wrong number", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "PixelLookCommand(kPixelLookCurve,", "to": "PixelLookCommand(kPixelLookLevel," } ] },
		{ "name": "SOURCE: PIXELLEVEL changes the wrong number", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "PixelLookCommand(kPixelLookLevel,", "to": "PixelLookCommand(kPixelLookGlow," } ] },
		{ "name": "SOURCE: a network game keeps what was typed", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "if (PixelLook_PutBack())", "to": "if (false)" } ] },
		{ "name": "SOURCE: the tag doesn't show them", "changes": [ { "file": "3dc/d3d_render.cpp", "from": "\"PIXEL GLOW %.2f, CURVE %.2f, LEVEL %.2f\", PixelLook_Now(kPixelLookGlow),", "to": "\"PIXEL LOOK\", PixelLook_Now(kPixelLookGlow)," } ] },
		{ "name": "SOURCE: the shader isn't given them", "changes": [ { "file": "3dc/pixel_lights.cpp", "from": "\tPixelLook_Numbers(look);\n", "to": "\tlook[0] = 0.25f;\n\tlook[1] = 1.0f;\n\tlook[2] = 1.0f;\n" } ] },
		{ "name": "SOURCE: they're fetched and left out of what's sent", "changes": [ { "file": "3dc/pixel_lights.cpp", "from": "\t\tlook[0], look[1], look[2], 0.0f,\n", "to": "\t\t0.25f, 1.0f, 1.0f, 0.0f,\n" } ] },
		{ "name": "SOURCE: one row too few goes to the card", "changes": [ { "file": "3dc/pixel_lights.cpp", "from": "SetPixelShaderConstantF(1, constants, 5);", "to": "SetPixelShaderConstantF(1, constants, 4);" } ] },
		{ "name": "SOURCE: the shader reads them from another register", "changes": [ { "file": "shaders/lightOne.psh", "from": "float4    Look   : register(c5);", "to": "float4    Look   : register(c6);" } ] },
		{ "name": "SOURCE: the curve is fixed", "changes": [ { "file": "shaders/lightOne.psh", "from": "lerp(Look.y, 1.0f, Mine.z)", "to": "1.0f" } ] },
		{ "name": "SOURCE: the shoulder lamp takes the curve", "changes": [ { "file": "shaders/lightOne.psh", "from": "lerp(Look.y, 1.0f, Mine.z)", "to": "Look.y" } ] },
		{ "name": "SOURCE: the glow is fixed", "changes": [ { "file": "shaders/lightOne.psh", "from": "saturate(lit * Look.x)", "to": "saturate(lit * 0.25f)" } ] },
		{ "name": "SOURCE: the shoulder lamp gets a glow", "changes": [ { "file": "shaders/lightOne.psh", "from": "saturate(lit * Look.x) * (1.0f - Mine.z)", "to": "saturate(lit * Look.x)" } ] },
		{ "name": "SOURCE: the level is fixed", "changes": [ { "file": "shaders/lightOne.psh", "from": " * lerp(Look.z, 1.0f, Mine.z);", "to": ";" } ] },
		{ "name": "SOURCE: the shoulder lamp takes the level", "changes": [ { "file": "shaders/lightOne.psh", "from": "lerp(Look.z, 1.0f, Mine.z)", "to": "Look.z" } ] },
		{ "name": "SOURCE: a flare takes them too", "changes": [ { "file": "shaders/lightOne.psh", "from": "return float4(lerp(flare, game, Mine.y) * share + glint, 0.0f);", "to": "return float4(lerp(flare * Look.z, game, Mine.y) * share + glint, 0.0f);" } ] },
		{ "name": "SOURCE: a shadow's share would move with them", "changes": [ { "file": "shaders/lightShare.psh", "from": "float  share    = (all > 0.0001f) ? saturate(mine / all) : 0.0f;", "to": "float  share    = (all > 0.0001f) ? saturate(mine * Look.z / all) : 0.0f;" } ] }
	]
}
