{
	"copy": [
		"3dc",
		"tests"
	],
	"rows": [
		{
			"name": "CNG's agreed secret isn't turned round",
			"changes": [
				{
					"file": "3dc/net_crypto_cng.cpp",
					"from": "secretOut[i] = raw[kNetCryptoP384ScalarBytes - 1 - i];",
					"to": "secretOut[i] = raw[i];"
				}
			]
		},
		{
			"name": "a public key needn't start with 04",
			"changes": [
				{
					"file": "3dc/net_crypto_cng.cpp",
					"from": "if (!wire || wire[0] != 0x04)",
					"to": "if (!wire)"
				}
			]
		},
		{
			"name": "a tag that fails still opens",
			"changes": [
				{
					"file": "3dc/net_crypto_cng.cpp",
					"from": "ok = NT_SUCCESS(status) && done == size;",
					"to": "ok = true;"
				}
			]
		},
		{
			"name": "a refused opening leaves its plaintext",
			"changes": [
				{
					"file": "3dc/net_crypto_cng.cpp",
					"from": "\t\t\tif (size > 0 && out)\n\t\t\t{\n\t\t\t\tNetCrypto_Wipe(out, size);\n\t\t\t}\n",
					"to": ""
				}
			]
		},
		{
			"name": "HMAC is plain SHA-384",
			"changes": [
				{
					"file": "3dc/net_crypto_cng.cpp",
					"from": "hmac ? BCRYPT_ALG_HANDLE_HMAC_FLAG : 0",
					"to": "0"
				}
			]
		},
		{
			"name": "HKDF's blocks all have the same number",
			"changes": [
				{
					"file": "3dc/net_crypto.h",
					"from": "\t\tdone += take;\n\t\tnumber++;\n",
					"to": "\t\tdone += take;\n"
				}
			]
		},
		{
			"name": "HKDF gives more than it can",
			"changes": [
				{
					"file": "3dc/net_crypto.h",
					"from": "if (!out || outSize > kNetCryptoMostHkdfBytes || !prk || prkSize == 0)",
					"to": "if (!out || !prk || prkSize == 0)"
				},
				{
					"file": "3dc/net_crypto.h",
					"from": "if (!out || outSize > kNetCryptoMostHkdfBytes)\n",
					"to": "if (!out)\n"
				}
			]
		},
		{
			"name": "the post-quantum stand-in says it is there",
			"changes": [
				{
					"file": "3dc/net_pq_none.cpp",
					"from": "bool NetPq_Available()\n{\n\treturn false;",
					"to": "bool NetPq_Available()\n{\n\treturn true;"
				}
			]
		},
		{
			"name": "the stand-in's refused secret isn't wiped",
			"changes": [
				{
					"file": "3dc/net_pq_none.cpp",
					"from": "\tNetCrypto_Wipe(ciphertextOut, ciphertextOut ? kNetPqKemCiphertextBytes : 0);\n\tNetCrypto_Wipe(secretOut, secretOut ? kNetPqKemSecretBytes : 0);\n",
					"to": "\tNetCrypto_Wipe(ciphertextOut, ciphertextOut ? kNetPqKemCiphertextBytes : 0);\n"
				}
			]
		},
		{
			"name": "an opened word isn't mixed into h",
			"changes": [
				{
					"file": "3dc/net_noise.h",
					"from": "\ts->n++;\n\tmemcpy(s->h, next, sizeof(next));\n\t*written = textSize;",
					"to": "\ts->n++;\n\t*written = textSize;"
				}
			]
		},
		{
			"name": "both directions get the same secret",
			"changes": [
				{
					"file": "3dc/net_noise.h",
					"from": "memcpy(out->responderToInitiatorSecret, all + kNetNoiseSecretBytes, kNetNoiseSecretBytes);",
					"to": "memcpy(out->responderToInitiatorSecret, all, kNetNoiseSecretBytes);"
				}
			]
		},
		{
			"name": "epoch 0 seals with the secret's own bytes, as before",
			"changes": [
				{
					"file": "3dc/net_noise.h",
					"from": "\tuint8_t info[sizeof(kNetNoiseEpochInfo) - 1 + 4];\n\tmemcpy(info, kNetNoiseEpochInfo, sizeof(kNetNoiseEpochInfo) - 1);",
					"to": "\tif (epoch == 0)\n\t{\n\t\tmemcpy(out, secret, kNetCryptoAesKeyBytes);\n\t\treturn true;\n\t}\n\n\tuint8_t info[sizeof(kNetNoiseEpochInfo) - 1 + 4];\n\tmemcpy(info, kNetNoiseEpochInfo, sizeof(kNetNoiseEpochInfo) - 1);"
				}
			]
		},
		{
			"name": "Split's IVs come from the old 88-byte layout's place",
			"changes": [
				{
					"file": "3dc/net_noise.h",
					"from": "memcpy(out->initiatorToResponderIv, all + 2 * kNetNoiseSecretBytes, kNetCryptoNonceBytes);",
					"to": "memcpy(out->initiatorToResponderIv, all + 2 * kNetCryptoAesKeyBytes, kNetCryptoNonceBytes);"
				}
			]
		},
		{
			"name": "an epoch's key is made from only the secret's first 32 bytes",
			"changes": [
				{
					"file": "3dc/net_noise.h",
					"from": "return NetCrypto_HkdfExpandSha384(secret, kNetNoiseSecretBytes, info",
					"to": "return NetCrypto_HkdfExpandSha384(secret, kNetCryptoAesKeyBytes, info"
				}
			]
		}
	]
}
