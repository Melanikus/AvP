				{
					"file": "3dc/avp/m79.h",
					"from": "state.GunWasEmptyAtChange = state.RoundsInGun[oldKind] > 0 ? 0 : 1;",
					"to": "state.GunWasEmptyAtChange = 0;"
				}
			]
		},
