{
	"copy": [
		"3dc",
		"tests"
	],
	"rows": [
		{
			"name": "a kind below the list isn't real",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "return kind >= 0 && kind < kM79Kinds;",
					"to": "return kind < kM79Kinds;"
				}
			]
		},
		{
			"name": "a kind past the list isn't real",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "return kind >= 0 && kind < kM79Kinds;",
					"to": "return kind >= 0;"
				}
			]
		},
		{
			"name": "a loaded grenade counts as ammunition",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "(state.RoundsInGun[kind] > 0 || state.Spares[kind] > 0)",
					"to": "(state.Spares[kind] > 0)"
				}
			]
		},
		{
			"name": "spares count as ammunition",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "(state.RoundsInGun[kind] > 0 || state.Spares[kind] > 0)",
					"to": "(state.RoundsInGun[kind] > 0)"
				}
			]
		},
		{
			"name": "the search checks where it starts",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "if (!M79_KindIsReal(after))\n\t{\n\t\treturn -1;\n\t}\n",
					"to": ""
				}
			]
		},
		{
			"name": "the search doesn't count this kind",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "for (int step = 1; step < kM79Kinds; step++)",
					"to": "for (int step = 1; step <= kM79Kinds; step++)"
				}
			]
		},
		{
			"name": "the search goes round",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "int const kind = (after + step) % kM79Kinds;",
					"to": "int const kind = after + step;"
				}
			]
		},
		{
			"name": "a change clears what was waiting",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "state.ChangeIsWaiting = 0;\n\tstate.ChangeCountdown = 0;\n\n\tif (!M79_KindIsReal(newKind)",
					"to": "if (!M79_KindIsReal(newKind)"
				}
			]
		},
		{
			"name": "a change refuses a kind that isn't real",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "if (!M79_KindIsReal(newKind) || !M79_KindIsReal(state.Kind) || newKind == state.Kind)",
					"to": "if (!M79_KindIsReal(state.Kind) || newKind == state.Kind)"
				}
			]
		},
		{
			"name": "a change to the same kind does nothing",
			"changes": [
				{
					"file": "3dc/avp/m79.h",
					"from": "if (!M79_KindIsReal(newKind) || !M79_KindIsReal(state.Kind) || newKind == state.Kind)",
					"to": "if (!M79_KindIsReal(newKind) || !M79_KindIsReal(state.Kind))"
				}
			]
		},
		{
