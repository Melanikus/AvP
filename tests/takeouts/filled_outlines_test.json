			"changes": [
				{ "file": "3dc/static_scene.cpp", "from": "WireFrameMode || DrawFilledOutlines || !StaticScene_ViewAllows()", "to": "WireFrameMode || !StaticScene_ViewAllows()" }
			]
		},
		{
