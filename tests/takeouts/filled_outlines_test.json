				{ "file": "3dc/d3d_render.cpp", "from": "\tmainList->DrawOpaqueAgain(d3d.mainDecl, false, false, false);\n\n\tasItWas->Apply();\n", "to": "\tmainList->DrawOpaqueAgain(d3d.mainDecl, false, false, false);\n\n" }
			]
