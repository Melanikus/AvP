	"rows": [
		{
			"name": "Stop keeps the map",
			"changes": [
				{
					"file": "3dc/avp/alien_ways_build.cpp",
					"from": "\t// Clear also forgets the stop, ready for the next build\n\tmap.Clear();\n",
					"to": ""
				}
			]
		},
		{
			"name": "the build always takes a thread, even when told it can't have one",
			"changes": [
				{
					"file": "3dc/avp/alien_ways_build.cpp",
					"from": "\tif (!noThreadForATest)\n",
					"to": "\tif (true)\n"
				}
			]
		},
		{
			"name": "a build on its own thread says it wasn't",
			"changes": [
				{
					"file": "3dc/avp/alien_ways_build.cpp",
					"from": "\t\t\townThread = true;",
					"to": "\t\t\townThread = false;"
				}
			]
		},
		{
			"name": "a refused build says it's ready",
			"changes": [
				{
					"file": "3dc/avp/alien_ways_build.cpp",
					"from": "state.store(said ? kAlienWaysRefused : kAlienWaysReady, std::memory_order_release);",
					"to": "state.store(kAlienWaysReady, std::memory_order_release);"
				}
			]
		},
		{
			"name": "SOURCE: a game's start doesn't build the map",
