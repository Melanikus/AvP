{
	"copy": [
		"3dc",
		"tests"
	],
	"rows": [
		{
			"name": "the yes doesn't come first",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (lineState == kRelayLineNoYes)\n\t{\n\t\treturn kOnlinePageSaysNoYes;\n\t}\n",
					"to": ""
				}
			]
		},
		{
			"name": "an access state the page doesn't know is called approved",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (access != kRelayAccessIsApproved)\n\t{\n\t\treturn kOnlinePageSaysNotAsked;\n\t}\n",
					"to": ""
				}
			]
		},
		{
			"name": "a refused line can be asked again",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (says == kOnlinePageSaysAsking || says == kOnlinePageSaysRefused)\n",
					"to": "\tif (says == kOnlinePageSaysAsking)\n"
				}
			]
		},
		{
			"name": "a line is asked twice in a minute",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (askedThisRun && static_cast<uint32_t>(now - lastAskedAt) < kOnlinePageAskEveryMs)\n",
					"to": "\tif (false)\n"
				}
			]
		},
		{
			"name": "the screenful doesn't follow the chosen line",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tview.first = (place / kOnlinePageMostShown) * kOnlinePageMostShown;\n",
					"to": "\tview.first = 0;\n"
				}
			]
		},
		{
			"name": "a waiting line doesn't name the code",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\t\tsnprintf(out, room, \"%s%s%s\", before, code ? code : \"\", after);\n",
					"to": "\t\tsnprintf(out, room, \"%s%s\", before, after);\n"
				}
			]
		},
		{
			"name": "ours and not ours are swapped",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "ours ? (oursWords ? oursWords : \"\") : (notOursWords ? notOursWords : \"\")",
					"to": "!ours ? (oursWords ? oursWords : \"\") : (notOursWords ? notOursWords : \"\")"
				}
			]
		},
		{
			"name": "a refused line shows no number",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tsnprintf(out, room, \"%s %d: %s\", lineWords ? lineWords : \"\", lineNumber, why ? why : \"\");\n",
					"to": "\tsnprintf(out, room, \"%s: %s\", lineWords ? lineWords : \"\", why ? why : \"\");\n"
				}
			]
		},
		{
			"name": "a line never visited says Asking... in its ping's place",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (lineState == kRelayLineNoYes || lineState == kRelayLineNotAsked)\n\t{\n\t\treturn kOnlinePagePingNothing;\n\t}\n\n",
					"to": ""
				}
			]
		},
		{
			"name": "a line that didn't answer says Asking... in its ping's place",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (lineState == kRelayLineNoAnswer || access == kRelayAccessNoAnswer)\n",
					"to": "\tif (false)\n"
				}
			]
		},
		{
			"name": "a name line with nothing in its ping's place ends with \" - \"",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "\tif (ping[0])\n\t{\n\t\tsnprintf(out, room, \"%s (%s) - %s\"",
					"to": "\tif (true)\n\t{\n\t\tsnprintf(out, room, \"%s (%s) - %s\""
				}
			]
		},
		{
			"name": "the title and the code's line are glued",
			"changes": [
				{
					"file": "3dc/avp/win95/frontend/online_page_rules.h",
					"from": "int const kOnlinePageTitleGap = 12;",
					"to": "int const kOnlinePageTitleGap = 0;"
				}
			]
		}
	]
}
