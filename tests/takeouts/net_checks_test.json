{
	"copy": [
		"3dc",
		"tests",
		"win32"
	],
	"rows": [
		{
			"name": "control characters stay in text",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (letter < 32 || letter == 127)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a copied name isn't cleaned",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "\tNetCleanText(to, size);\n",
					"to": ""
				}
			]
		},
		{
			"name": "a name someone has is kept",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (!used(name))\n\t{\n\t\treturn true;\n\t}\n\n\tchar original[32];",
					"to": "return true;\n\n\tchar original[32];"
				}
			]
		},
		{
			"name": "a typed address part can be any size",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (digits > 3 || value > 255)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a typed address can read past its room",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "while (at < most && text[at] >= '0' && text[at] <= '9')",
					"to": "while (text[at] >= '0' && text[at] <= '9')"
				}
			]
		},
		{
			"name": "a typed address can have anything after it",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return at < most && text[at] == '\\0';",
					"to": "return true;"
				}
			]
		},
		{
			"name": "a typed address can have an empty part",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (digits == 0)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a negative damage multiple is good",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return multiple >= 0 && multiple <= kNetMostDamageMultiple;",
					"to": "return multiple <= kNetMostDamageMultiple;"
				}
			]
		},
		{
			"name": "a huge damage multiple is good",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return multiple >= 0 && multiple <= kNetMostDamageMultiple;",
					"to": "return multiple >= 0;"
				}
			]
		},
		{
			"name": "any number of answers a second",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (*used >= most)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a new second never starts",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (now - *secondStarted >= 1000)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a number below the table fits",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return number >= 0 && number < places;",
					"to": "return number < places;"
				}
			]
		},
		{
			"name": "a number past the table fits",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return number >= 0 && number < places;",
					"to": "return number >= 0;"
				}
			]
		},
		{
			"name": "the log gets every drop",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return (count <= kDropsLoggedInFull) || ((count & (count - 1)) == 0);",
					"to": "return true;"
				}
			]
		},
		{
			"name": "a name has no end",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "to[size - 1] = '\\0';",
					"to": ""
				}
			]
		},
		{
			"name": "the walk stops after one part",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "at += length;",
					"to": "return kNetPartsGood;"
				}
			]
		},
		{
			"name": "the walk never moves",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "at += length;",
					"to": ""
				}
			]
		},
		{
			"name": "a kind past the table is read",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (kind >= ruleCount)",
					"to": "if (kind > ruleCount)"
				}
			]
		},
		{
			"name": "the host-only check is missing",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (rule.onlyFromTheHost && !fromTheHost)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "the host is refused too",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (rule.onlyFromTheHost && !fromTheHost)",
					"to": "if (rule.onlyFromTheHost)"
				}
			]
		},
		{
			"name": "a short part is read",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (length > bytesLeft)\n\t\t{\n\t\t\treturn kNetPartsTooShort;",
					"to": "if (false)\n\t\t{\n\t\t\treturn kNetPartsTooShort;"
				}
			]
		},
		{
			"name": "a part whose length varies is taken as the least",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (rule.lengthVaries)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a length of 0 is believed",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (length == 0 || length > bytesLeft)",
					"to": "if (length > bytesLeft)"
				}
			]
		},
		{
			"name": "a part can claim more than there is",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "if (length == 0 || length > bytesLeft)",
					"to": "if (length == 0)"
				}
			]
		},
		{
			"name": "a chat line reads past the message",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "for (size_t i = 1; i < bytesLeft && i <= kNetMostChatLetters + 1; i++)",
					"to": "for (size_t i = 1; i <= kNetMostChatLetters + 1; i++)"
				}
			]
		},
		{
			"name": "a chat line can be any length",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "for (size_t i = 1; i < bytesLeft && i <= kNetMostChatLetters + 1; i++)",
					"to": "for (size_t i = 1; i < bytesLeft; i++)"
				}
			]
		},
		{
			"name": "a chat line is one too short",
			"changes": [
				{
					"file": "3dc/net_checks.h",
					"from": "return i + 1;",
					"to": "return i;"
				}
			]
		}
	]
}
