// Pixel shader input structure
struct PS_INPUT
{
    float3 ViewPosition : TEXCOORD0;
    float2 Texture      : TEXCOORD1;
    float2 ScreenPlace  : VPOS;
};

// Global variables
sampler2D Tex0   : register(s0);       // the polygon's own texture
sampler2D Mask   : register(s1);       // where this light is blocked, 0 to 1
sampler2D Depth  : register(s2);       // how far away each pixel of the level is
float4    Light  : register(c0);       // this light: x y z, and one over its range
float4    Colour : register(c1);       // its colour in x y z, and how bright it is in w
float4    Soft   : register(c2);       // x y: one pixel, as a distance on the texture. z: how wide the soft edge is, in pixels, up
                                       // close, or below 0 for no mask at all. w: how far away it stays that wide
float4    Lights[12] : register(c3);   // every light added per pixel this frame: x y z, and one over its range
float4    Bright[12] : register(c15);  // x: how bright each of those is. y: 0 for a flare, 1 for any other. Places not in use stay at 0
float4    Mine       : register(c27);  // the same two numbers for this light

// where to look around a pixel: spread evenly over a circle of radius 1
static const float2 kPlaces[12] =
{
    float2(-0.326f, -0.406f), float2(-0.840f, -0.074f), float2(-0.696f,  0.457f), float2(-0.203f,  0.621f),
    float2( 0.962f, -0.195f), float2( 0.473f, -0.480f), float2( 0.519f,  0.767f), float2( 0.185f, -0.893f),
    float2( 0.507f,  0.064f), float2( 0.896f,  0.412f), float2(-0.322f, -0.933f), float2(-0.792f, -0.598f),
};


// How much of this light is blocked here, softened by averaging the mask around the pixel. A neighbour on a different
// surface is left out, so a shadow doesn't bleed from a wall onto something in front of it.
float BlockedHere(float2 place, float here)
{
    float wide  = Soft.z * min(1.0f, Soft.w / max(here, 1.0f));
    float total = tex2Dlod(Mask, float4(place, 0.0f, 0.0f)).r;
    float count = 1.0f;

    for (int i = 0; i < 12; i++)
    {
        float2 near  = place + kPlaces[i] * Soft.xy * wide;
        float  there = tex2Dlod(Depth, float4(near, 0.0f, 0.0f)).r;
        float  same  = saturate(1.0f - abs(there - here) / (here * 0.04f + 30.0f));

        total += same * tex2Dlod(Mask, float4(near, 0.0f, 0.0f)).r;
        count += same;
    }

    return total / count;
}

// How much light one light gives this spot, in one of two shapes. bright.x is how bright it is, and bright.y picks the shape.
// A flare stays strong for most of its reach and falls away near the end, so flares across a room count for something next to one
// close by, and a surface turned away from it gets none. Any other light is worked out the way the game works it out at each corner
// of a polygon (kshape.cpp, VertexIntensity_Standard): it fades in a straight line, and a surface turned away still gets an eighth.
float LightHere(float4 light, float2 bright, float3 position, float3 normal)
{
    float3 toLight = light.xyz - position;
    float  howFar  = length(toLight);
    float  reach   = saturate(howFar * light.w);
    float  turned  = dot(normal, toLight / max(howFar, 1.0f));

    float  flare   = (1.0f - reach * reach) * ((turned > 0.0f) ? (turned + 0.25f) * 0.5f : 0.0f);
    float  game    = (1.0f - reach) * ((turned > 0.0f) ? (turned + 0.25f) * 0.5f : 0.125f);

    return bright.x * lerp(flare, game, bright.y);
}


// Name: Per-pixel light shader
// Type: Pixel shader
// Desc: The light of one light on one pixel, added to the picture. While shadows are on, chosen live lights are left out of the
// game's lighting, and this is the only light they give. The mask says where the light is blocked, so it lights nothing it can't
// see, and the edge of its shadow is soft.
//
// All these lights together only give so much, and each takes its share of that. Just adding them would hide a shadow: once a
// close light has used up the room, a pixel lit by one light looks the same as one lit by two, so the far light's shadow can't be
// seen. With shares, blocking a light always takes out exactly its part, so each one shows.
//
// A flare is the dim red the user chose: all of them together light a pixel up to its own texture, in the flare's own colour.
// Any other light gives what the game would give: the texture lit by it, each colour stopping at full, plus a quarter of it again
// with no texture, which is the glow.

float4 ps_main(in PS_INPUT In) : COLOR0
{
    // which way this surface faces: how the position changes across the screen gives two lines lying along the surface
    float3 normal = normalize(cross(ddx(In.ViewPosition), ddy(In.ViewPosition)));
    if (dot(normal, In.ViewPosition) > 0.0f)
    {
        normal = -normal;
    }

    float all = 0.0f;

    for (int i = 0; i < 12; i++)
    {
        all += LightHere(Lights[i], Bright[i].xy, In.ViewPosition, normal);
    }

    float mine  = LightHere(Light, Mine.xy, In.ViewPosition, normal);
    float share = (all > 0.0001f) ? saturate(mine / all) : 0.0f;

    if (Soft.z >= 0.0f)
    {
        share *= saturate(1.0f - BlockedHere((In.ScreenPlace + 0.5f) * Soft.xy, In.ViewPosition.z));
    }

    float3 texel = tex2D(Tex0, In.Texture).rgb;
    float3 lit   = all * Colour.rgb;
    float3 flare = texel * Colour.rgb * saturate(all);
    float3 game  = texel * saturate(lit) + saturate(lit * 0.25f);

    return float4(lerp(flare, game, Mine.y) * share, 0.0f);
}
