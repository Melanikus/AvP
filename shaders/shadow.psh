// Pixel shader input structure
struct PS_INPUT
{
    float3 ViewPosition : TEXCOORD0;
    float3 Normal       : TEXCOORD1;
};

// Global variables
float4 Lights[12]  : register(c0);    // each chosen light: x y z, and one over its range
float4 Weights[12] : register(c12);    // x: how bright each light is. y: 0 for a light baked into the walls, 1 for one worked out live
float4 ThisLight  : register(c24);   // the light this pass is for: x y z, and one over its range
float4 ThisWeight : register(c25);   // its x and y, as above. z: how much of its share to take, 1 for an ordinary shadow


// How much light one lamp gives this spot. The game lights the world in two ways, and each is copied here. Baked lights fade
// along a cosine and depend on how squarely the surface faces them. Live ones, like a flare, fade in a straight line, and they
// still give some light to a surface at a low angle or turned away, so a flare lying on the floor lights the floor well.
float LightHere(float4 light, float4 weight, float3 position, float3 normal)
{
    float3 toLight = light.xyz - position;
    float  howFar  = length(toLight);
    float  reach   = saturate(howFar * light.w);
    float  turned  = dot(normal, toLight / max(howFar, 1.0f));

    float  baked   = cos(1.5707963f * reach) * saturate(turned);
    float  live    = (1.0f - reach) * ((turned > 0.0f) ? (turned + 0.25f) * 0.5f : 0.125f);

    return weight.x * lerp(baked, live, weight.y);
}


// Name: Shadow pixel shader
// Type: Pixel shader
// Desc: Runs on pixels one light can't reach. Works out that light's share of all the light on this spot, and writes it down.
// The mask adds these up, one pass for each light, so it ends up holding the part of this pixel's light that is blocked. The
// shares of all the lights add up to 1, so that can't go over 1, and a spot lit by a second light keeps exactly that light.

float4 ps_main(in PS_INPUT In) : COLOR0
{
    float3 normal = normalize(In.Normal);
    float  all    = 0.0f;

    for (int i = 0; i < 12; i++)
    {
        all += LightHere(Lights[i], Weights[i], In.ViewPosition, normal);
    }

    float mine  = LightHere(ThisLight, ThisWeight, In.ViewPosition, normal);
    float share = (all > 0.0001f) ? saturate(mine / all) : 0.0f;

    share *= ThisWeight.z;

    return float4(share, share, share, 1.0f);
}
