// Pixel shader input structure
struct PS_INPUT
{
    float2 ScreenPlace : VPOS;
};

#include "lightShapes.fxh"

// Global variables. c0 is Screen: see lightShapes.fxh
sampler2D Totals : register(s3);       // from lightTotal.psh
sampler2D Mask   : register(s4);       // where this light is blocked, 0 to 1
float4    Light  : register(c1);       // this light: x y z, and one over its range
float4    Colour : register(c2);       // its colour in x y z
float4    Soft   : register(c3);       // x: how wide the soft edge is, in pixels, up close. y: how far away it stays that wide
float4    Mine   : register(c4);       // x: how bright it is. y: 0 for a flare, 1 for any other

// where to look around a pixel: spread evenly over a circle of radius 1
static const float2 kPlaces[12] =
{
    float2(-0.326f, -0.406f), float2(-0.840f, -0.074f), float2(-0.696f,  0.457f), float2(-0.203f,  0.621f),
    float2( 0.962f, -0.195f), float2( 0.473f, -0.480f), float2( 0.519f,  0.767f), float2( 0.185f, -0.893f),
    float2( 0.507f,  0.064f), float2( 0.896f,  0.412f), float2(-0.322f, -0.933f), float2(-0.792f, -0.598f),
};


// How much of this light is blocked here, softened by averaging the mask around the pixel. A neighbour on a different
// surface is left out, so a shadow doesn't bleed from a wall onto something in front of it.
float BlockedHere(float2 place, float here)
{
    float wide  = Soft.x * min(1.0f, Soft.y / max(here, 1.0f));
    float total = tex2Dlod(Mask, float4(place, 0.0f, 0.0f)).r;
    float count = 1.0f;

    for (int i = 0; i < 12; i++)
    {
        float2 near  = place + kPlaces[i] * Screen.xy * wide;
        float  there = tex2Dlod(Depth, float4(near, 0.0f, 0.0f)).r;
        float  same  = saturate(1.0f - abs(there - here) / (here * 0.04f + 30.0f));

        total += same * tex2Dlod(Mask, float4(near, 0.0f, 0.0f)).r;
        count += same;
    }

    return total / count;
}


// Name: One light pixel shader
// Type: Pixel shader
// Desc: The light of one light on one pixel, added to the picture. While shadows are on, chosen live lights are left out of the game's
// lighting, and this is the only light they give. The mask says where the light is blocked, so it lights nothing it can't see, and the
// edge of its shadow is soft.
//
// All these lights together only give so much, and each takes its share of that. Just adding them would hide a shadow: once a close
// light has used up the room, a pixel lit by one light looks the same as one lit by two, so the far light's shadow can't be seen. With
// shares, blocking a light always takes out exactly its part, so each one shows.
//
// A flare is the dim red the user chose: all of them together light a pixel up to its own texture, in the flare's own colour. Any other
// light gives what the game would give: the texture lit by it, each colour stopping at full, plus a quarter of it again with no texture,
// which is the glow.

float4 ps_main(in PS_INPUT In) : COLOR0
{
    float4 place   = PlaceOnPicture(In.ScreenPlace);
    float4 surface = tex2Dlod(Colours, place);

    clip(surface.a - 0.5f);

    float  distance = tex2Dlod(Depth, place).r;
    float3 position = PositionHere(In.ScreenPlace, distance);
    float3 normal   = NormalHere(place);
    float  all      = tex2Dlod(Totals, place).g;
    float  mine     = Mine.x * LightShape(Light, lerp(kShapeFlare, kShapeGame, Mine.y), position, normal);
    float  share    = (all > 0.0001f) ? saturate(mine / all) : 0.0f;

    share *= saturate(1.0f - BlockedHere(place.xy, distance));

    float3 lit   = all * Colour.rgb;
    float3 flare = surface.rgb * Colour.rgb * saturate(all);
    float3 game  = surface.rgb * saturate(lit) + saturate(lit * 0.25f);

    return float4(lerp(flare, game, Mine.y) * share, 0.0f);
}
