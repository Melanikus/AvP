// Pixel shader input structure
struct PS_INPUT
{
    float3 ViewPosition : TEXCOORD0;
    float3 Normal       : TEXCOORD1;
};


// Name: Shadow depth pixel shader
// Type: Pixel shader
// Desc: Writes down how far away each pixel of the level is. The softening of shadow edges needs this to know where one surface
// ends and another begins, and Direct3D 9 can't read the real depth buffer.

float4 ps_main(in PS_INPUT In) : COLOR0
{
    return float4(In.ViewPosition.z, 0.0f, 0.0f, 1.0f);
}
