// A polygon of the level's fixed buffer, drawn into the scene: the same sum as pixel.psh. That one is shader model 2, and a card won't join it to a model 3
// vertex shader, so this is its twin.
struct PS_INPUT
{
    float4 Diffuse  : COLOR0;
    float4 Specular : COLOR1;
    float2 Texture  : TEXCOORD0;
};

struct PS_OUTPUT
{
    float4 Color : COLOR0;
};

sampler2D Tex0 : register(s0);


// Name: Scene pixel shader for the level's fixed buffer
// Type: Pixel shader
// Desc: The texture times the light, and then the highlight added on top

PS_OUTPUT ps_main(in PS_INPUT In)
{
    PS_OUTPUT Out;

    Out.Color = tex2D(Tex0, In.Texture) * In.Diffuse + In.Specular;

    return Out;
}
