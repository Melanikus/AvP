<?xml version="1.0" encoding="utf-8"?>
<!-- msvc-pin.props: THE ONE COMPILER. Written 2026-11-21 by Melanikus (Frost) for the AvP port, Bishop for the owner after alpha.3 ("FIXING, NOT PATCHING").

     WHY: alpha.3's libsmackerenc.dll and mp4-to-smk.exe were each flagged by one antivirus engine; the same code built here scanned 0 of 71. The one
     difference was the compiler: GitHub's runner image (windows-2025-vs2026 20261116.315) had moved to MSVC 14.52.37025 under us, and this project
     builds with 14.51.36231. The same source gave other machine code (the Rich header, the linker version, .text's size), so what shipped was never
     what had been scanned. Pinning one exact compiler, on every machine, makes a build here and a build on CI the same bytes (with the deterministic
     flags each project sets), so the files scanned clean are the files that ship.

     WHAT: every project that ships imports this file after Microsoft.Cpp.Default.props and before Microsoft.Cpp.props. VCToolsVersion chooses the
     MSVC folder (VC\Tools\MSVC\<version>) the whole build uses: compiler, linker and libraries. Microsoft.Cpp.props fills it in with the newest
     installed one only when it is empty (Microsoft.Cpp.VCTools.props); set before Microsoft.Cpp.Default.props, a developer prompt would clear it
     (ClearDevCommandPromptEnvVars). The build FAILS, saying why, if the version is anything else (a /p:VCToolsVersion on the command line included)
     or that MSVC is not installed: it is never quietly built with another.

     THE FOLDER IS NOT ENOUGH (Frost 2026-11-22, the first CI build with the pin, editor PR #98): Microsoft re-services a toolset under the same folder
     name. CI's Visual Studio 18.12 installed the 14.51 tools package 14.51.36263 into VC\Tools\MSVC\14.51.36231, while a Visual Studio 18.11 here
     had 14.51.36260 in that same folder: the two compilers made other machine code from the same source (.text and the Rich header differ; imports
     and resources were the same). So the compiler's own build is pinned too (AvpxMsvcBuild: the third number of cl.exe's and link.exe's version,
     19.51.<build> and 14.51.<build>), and every build reads it from the two programs' own banners and FAILS on any other.

     TO MOVE IT: change AvpxMsvcVersion (the folder) and AvpxMsvcBuild (the build in it) here, install that MSVC on every machine that builds (Visual
     Studio Installer, the "MSVC v145 build tools" of that version; a machine whose folder holds another build updates Visual Studio), build, and have
     the result scanned before anything ships. CI installs the same version from Microsoft's own installer, and stops when the installer's catalog
     serves another build (tools/install-msvc-pin.ps1). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AvpxMsvcVersion>14.51.36231</AvpxMsvcVersion>
    <AvpxMsvcBuild>36263</AvpxMsvcBuild>
    <VCToolsVersion>$(AvpxMsvcVersion)</VCToolsVersion>
  </PropertyGroup>
  <Target Name="AvpxMsvcPinCheck" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(VCToolsVersion)' != '$(AvpxMsvcVersion)'" Text="This build must use MSVC $(AvpxMsvcVersion) (msvc-pin.props), and it was asked for $(VCToolsVersion)." />
    <Error Condition="!Exists('$(VCToolsInstallDir)bin\Hostx64\x86\cl.exe') and !Exists('$(VCToolsInstallDir)bin\Hostx86\x86\cl.exe')" Text="MSVC $(AvpxMsvcVersion) is not installed here (no compiler in $(VCToolsInstallDir)): install it with the Visual Studio Installer, as msvc-pin.props says." />
    <!-- The compiler and the linker the build uses (the host the build picks: 64-bit when this machine has it), each run once with no arguments, in
         English (VSLANG=1033), so its first line says its version whatever the machine's language: "... Version 19.51.36263 for x86". -->
    <PropertyGroup>
      <AvpxMsvcBin Condition="Exists('$(VCToolsInstallDir)bin\Hostx64\x86\cl.exe')">$(VCToolsInstallDir)bin\Hostx64\x86\</AvpxMsvcBin>
      <AvpxMsvcBin Condition="'$(AvpxMsvcBin)' == ''">$(VCToolsInstallDir)bin\Hostx86\x86\</AvpxMsvcBin>
    </PropertyGroup>
    <Exec Command="&quot;$(AvpxMsvcBin)cl.exe&quot;" EnvironmentVariables="VSLANG=1033" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="AvpxClBanner" />
    </Exec>
    <Exec Command="&quot;$(AvpxMsvcBin)link.exe&quot;" EnvironmentVariables="VSLANG=1033" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="AvpxLinkBanner" />
    </Exec>
    <!-- The third number of "Version 19.51.36263" (cl) and "Version 14.51.36263.0" (link); empty when a banner has no such words -->
    <PropertyGroup>
      <AvpxClBuild>$([System.Text.RegularExpressions.Regex]::Match(`$(AvpxClBanner)`, `(?&lt;=Version 19\.[0-9]+\.)[0-9]+`).Value)</AvpxClBuild>
      <AvpxLinkBuild>$([System.Text.RegularExpressions.Regex]::Match(`$(AvpxLinkBanner)`, `(?&lt;=Version 14\.[0-9]+\.)[0-9]+`).Value)</AvpxLinkBuild>
    </PropertyGroup>
    <Error Condition="'$(AvpxClBuild)' != '$(AvpxMsvcBuild)' or '$(AvpxLinkBuild)' != '$(AvpxMsvcBuild)'" Text="This build must use MSVC $(AvpxMsvcVersion) build $(AvpxMsvcBuild) (msvc-pin.props), and $(AvpxMsvcBin) holds compiler build '$(AvpxClBuild)' and linker build '$(AvpxLinkBuild)': Microsoft re-serviced the toolset under the same folder. Update this machine's Visual Studio (its MSVC $(AvpxMsvcVersion) build tools) to build $(AvpxMsvcBuild), or move the pin on purpose, with a scan, as msvc-pin.props says." />
  </Target>
</Project>
