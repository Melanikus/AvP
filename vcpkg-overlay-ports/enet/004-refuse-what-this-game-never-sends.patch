diff --git a/protocol.c b/protocol.c
index 7616102..88f5a5d 100644
--- a/protocol.c
+++ b/protocol.c
@@ -695,6 +695,7 @@ enet_protocol_handle_send_unreliable_fragment (ENetHost * host, ENetPeer * peer,
     if (fragmentCount > ENET_PROTOCOL_MAXIMUM_FRAGMENT_COUNT ||
