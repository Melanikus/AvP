+/* Our own (AvP): every datagram this host sends goes out here, and nowhere else: through the program's send hook if it set
+   one, or straight to the socket if it didn't. The game sets a hook to seal each datagram end to end (protocol version 2);
+   with every send going through this one place, no datagram can leave around the hook, unsealed. */
+static int
+enet_protocol_send_datagram (ENetHost * host, const ENetAddress * address, const ENetBuffer * buffers, size_t bufferCount)
+{
+    if (host -> sendHook != NULL)
+      return host -> sendHook (host, address, buffers, bufferCount);
+
+    return enet_socket_send (host -> socket, address, buffers, bufferCount);
+}
