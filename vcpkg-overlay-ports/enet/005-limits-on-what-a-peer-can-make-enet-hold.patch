+/* Our own (AvP): copies a command that came in a packet. It owns only its own size there, not the whole union, so only
+   that much is copied and the rest is cleared, rather than read from whatever follows it in the packet. */
+static void
+enet_peer_copy_command (ENetProtocol * to, const ENetProtocol * from)
+{
+    size_t size = enet_protocol_command_size (from -> header.command);
+
+    if (size < sizeof (ENetProtocolCommandHeader))
+      size = sizeof (ENetProtocolCommandHeader);
+
+    memset (to, 0, sizeof (ENetProtocol));
+    memcpy (to, from, size);
+}
+
+/* Our own (AvP): what a message held for the program costs in memory: its bytes, and ENet's own records of it. The limit
+   on what's waiting (maximumWaitingData) counts all of this, so that messages with no bytes can't pile up for free. */
+static size_t
+enet_peer_incoming_command_cost (const ENetIncomingCommand * incomingCommand)
+{
+    size_t cost = sizeof (ENetIncomingCommand) + sizeof (ENetPacket) + incomingCommand -> packet -> dataLength;
+
+    if (incomingCommand -> fragments != NULL)
+      cost += (incomingCommand -> fragmentCount + 31) / 32 * sizeof (enet_uint32);
+
+    return cost;
+}
+
+/** @defgroup peer ENet peer functions
     @{
 */
 
