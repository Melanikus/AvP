+int
+enet_host_secret (enet_uint8 * secret, size_t size)
+{
+    /* Our own (AvP): the system's secure random source. Nobody can work these out from the outside, unlike
+       enet_host_random_seed above, which is only the time. */
+    FILE * source = fopen ("/dev/urandom", "rb");
+    size_t got;
+
+    if (source == NULL)
+      return -1;
+
+    got = fread (secret, 1, size, source);
+    fclose (source);
+
+    return got == size ? 0 : -1;
+}
