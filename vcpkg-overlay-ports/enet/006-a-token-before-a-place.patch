+/* Our own (AvP): puts a host's token into a connection's CONNECT, if it's in this list, and has it sent again at the next
+   chance rather than when its usual wait runs out. Says whether it was there. */
+static int
+enet_protocol_put_cookie_in_connect (ENetList * list, const ENetProtocol * command)
+{
+    ENetListIterator currentCommand;
+
+    for (currentCommand = enet_list_begin (list);
+         currentCommand != enet_list_end (list);
+         currentCommand = enet_list_next (currentCommand))
+    {
+       ENetOutgoingCommand * outgoingCommand = (ENetOutgoingCommand *) currentCommand;
+
+       if ((outgoingCommand -> command.header.command & ENET_PROTOCOL_COMMAND_MASK) != ENET_PROTOCOL_COMMAND_CONNECT)
+         continue;
+
+       memcpy (outgoingCommand -> command.connect.cookie, command -> cookie.cookie, ENET_PROTOCOL_COOKIE_SIZE);
+       outgoingCommand -> roundTripTimeout = 0;
+
+       return 1;
+    }
+
+    return 0;
+}
+
+/* Our own (AvP): a host has answered this machine's CONNECT with a token (see ENetProtocolCookie). It's taken only for a
+   connection that is still connecting, to the address the token came from, with the same connection number, which only
+   the two ends know. The CONNECT is waiting for its answer in one of two lists: sent, or waiting to be sent again. */
+static int
+enet_protocol_handle_cookie (ENetHost * host, const ENetProtocol * command)
+{
+    ENetPeer * currentPeer;
+
+    for (currentPeer = host -> peers;
+         currentPeer < & host -> peers [host -> peerCount];
+         ++ currentPeer)
+    {
+       if (currentPeer -> state != ENET_PEER_STATE_CONNECTING ||
+           currentPeer -> connectID != command -> cookie.connectID ||
+           currentPeer -> address.host != host -> receivedAddress.host ||
+           currentPeer -> address.port != host -> receivedAddress.port)
+         continue;
+
+       if (enet_protocol_put_cookie_in_connect (& currentPeer -> sentReliableCommands, command))
+         currentPeer -> nextTimeout = host -> serviceTime;
+       else
+         enet_protocol_put_cookie_in_connect (& currentPeer -> outgoingCommands, command);
+
+       break;
+    }
+
+    return 0;
+}
