+/* Our own (AvP): how long one slot of time is for the tokens a host gives a CONNECT, in milliseconds. Each slot has a fresh
+   key, and the key of the slot before is kept, so a token is taken for between one and two slots: far longer than a CONNECT
+   takes to come back, and too short to be kept and used later. */
+#define ENET_PROTOCOL_COOKIE_SLOT 10000
+
+/* Our own (AvP): brings the host's keys up to this slot: a fresh key from the system's secure random source, and the key of
+   the slot before, if there was one, kept for tokens given just before the slot changed. Gives back -1 if the system
+   couldn't give a key, and then no token is given or taken. */
+static int
+enet_protocol_cookie_keys (ENetHost * host, enet_uint32 slot)
+{
+    if (host -> cookieKeysMade && slot == host -> cookieSlot)
+      return 0;
+
+    host -> cookiePreviousKeyGood = host -> cookieKeysMade && slot == host -> cookieSlot + 1;
+    if (host -> cookiePreviousKeyGood)
+      memcpy (host -> cookieKeys [1], host -> cookieKeys [0], sizeof (host -> cookieKeys [0]));
+
+    host -> cookieKeysMade = 0;
+    if (enet_host_secret (host -> cookieKeys [0], sizeof (host -> cookieKeys [0])) < 0)
+    {
+       host -> cookiePreviousKeyGood = 0;
+       return -1;
+    }
+
+    host -> cookieKeysMade = 1;
+    host -> cookieSlot = slot;
+    return 0;
+}
+
+/* Our own (AvP): the token for a CONNECT from the address and port the packet came from, with this connection number, in
+   this slot, under this key. It's SipHash-2-4 (siphash.c, the reference code by Jean-Philippe Aumasson and Daniel J.
+   Bernstein, kept as it is): nobody without the key can work it out, and it's no good from any other address or later on. */
+static void
+enet_protocol_make_cookie (ENetHost * host, const enet_uint8 * key, enet_uint32 connectID, enet_uint32 slot, enet_uint8 * cookie)
+{
+    enet_uint8 message [sizeof (enet_uint32) + sizeof (enet_uint16) + sizeof (enet_uint32) + sizeof (enet_uint32)];
+    enet_uint8 tag [8];
+    size_t at = 0;
+
+    memcpy (message + at, & host -> receivedAddress.host, sizeof (enet_uint32));
+    at += sizeof (enet_uint32);
+    memcpy (message + at, & host -> receivedAddress.port, sizeof (enet_uint16));
+    at += sizeof (enet_uint16);
+    memcpy (message + at, & connectID, sizeof (enet_uint32));
+    at += sizeof (enet_uint32);
+    memcpy (message + at, & slot, sizeof (enet_uint32));
+
+    siphash (message, sizeof (message), key, tag, sizeof (tag));
+    memcpy (cookie, tag, ENET_PROTOCOL_COOKIE_SIZE);
+}
+
+/* Our own (AvP): whether two tokens are the same. Every byte is compared whatever the ones before were, so the time this
+   takes tells nobody how close a guess was. */
+static int
+enet_protocol_cookies_match (const enet_uint8 * one, const enet_uint8 * other)
+{
+    enet_uint8 difference = 0;
+    int i;
+
+    for (i = 0; i < ENET_PROTOCOL_COOKIE_SIZE; ++ i)
+      difference |= one [i] ^ other [i];
+
+    return difference == 0;
+}
+
+/* Our own (AvP): whether a CONNECT brought back a token this host gave that address and port, in this slot or the one
+   before */
+static int
+enet_protocol_cookie_is_good (ENetHost * host, const ENetProtocol * command)
+{
+    enet_uint32 slot = host -> serviceTime / ENET_PROTOCOL_COOKIE_SLOT;
+    enet_uint8 expected [ENET_PROTOCOL_COOKIE_SIZE];
+
+    if (enet_protocol_cookie_keys (host, slot) < 0)
+      return 0;
+
+    enet_protocol_make_cookie (host, host -> cookieKeys [0], command -> connect.connectID, slot, expected);
+    if (enet_protocol_cookies_match (expected, command -> connect.cookie))
+      return 1;
+
+    if (! host -> cookiePreviousKeyGood)
+      return 0;
+
+    enet_protocol_make_cookie (host, host -> cookieKeys [1], command -> connect.connectID, slot - 1, expected);
+    return enet_protocol_cookies_match (expected, command -> connect.cookie);
+}
+
+/* Our own (AvP): sends a command straight back to the address the packet came from, outside any connection, with the
+   checksum worked out the way the other end will check it: from seed, in the checksum's place */
+static void
+enet_protocol_send_outside_a_connection (ENetHost * host, enet_uint16 peerID, enet_uint32 seed, const void * command, size_t commandSize)
+{
+    enet_uint8 packet [sizeof (enet_uint16) + sizeof (enet_uint32) + sizeof (ENetProtocol)];
+    ENetBuffer buffer;
+    size_t length = 0, checksumAt = 0;
+
+    memcpy (packet, & peerID, sizeof (peerID));
+    length += sizeof (peerID);
+
+    if (host -> checksum != NULL)
+    {
+        checksumAt = length;
+        memcpy (packet + length, & seed, sizeof (seed));
+        length += sizeof (seed);
+    }
+
+    memcpy (packet + length, command, commandSize);
+    length += commandSize;
+
+    buffer.data = packet;
+    buffer.dataLength = length;
+
+    if (host -> checksum != NULL)
+    {
+        enet_uint32 checksum = host -> checksum (& buffer, 1);
+
+        memcpy (packet + checksumAt, & checksum, sizeof (checksum));
+    }
+
+    enet_socket_send (host -> socket, & host -> receivedAddress, & buffer, 1);
+}
+
+/* Our own (AvP): answers a CONNECT that brought no good token with a token, and keeps nothing. The answer is smaller than the
+   CONNECT, so made-up CONNECTs can't use this host to flood someone else. With no connection yet, the checksum starts from 0,
+   as it does for the CONNECT. */
+static void
+enet_protocol_send_cookie (ENetHost * host, const ENetProtocol * command)
+{
+    enet_uint32 slot = host -> serviceTime / ENET_PROTOCOL_COOKIE_SLOT;
+    ENetProtocolCookie answer;
+
+    if (enet_protocol_cookie_keys (host, slot) < 0)
+      return;
+
+    answer.header.command = ENET_PROTOCOL_COMMAND_COOKIE;
+    answer.header.channelID = 0xFF;
+    answer.header.reliableSequenceNumber = 0;
+    answer.connectID = command -> connect.connectID;
+    enet_protocol_make_cookie (host, host -> cookieKeys [0], command -> connect.connectID, slot, answer.cookie);
+
+    enet_protocol_send_outside_a_connection (host, ENET_HOST_TO_NET_16 (ENET_PROTOCOL_MAXIMUM_PEER_ID), 0, & answer, sizeof (answer));
+}
+
+/* Our own (AvP): a CONNECT from an ENet without the token is told no at once, with a reason, rather than left waiting for an
+   answer that never comes. The answer is a DISCONNECT, which every ENet understands, addressed to the place the sender gave
+   in its CONNECT and checked with its connection number, so the sender takes it. The host counts these, for its log. */
+static void
+enet_protocol_refuse_older_connect (ENetHost * host, const ENetProtocol * command)
+{
+    ENetProtocolDisconnect refusal;
+
+    refusal.header.command = ENET_PROTOCOL_COMMAND_DISCONNECT;
+    refusal.header.channelID = 0xFF;
+    refusal.header.reliableSequenceNumber = 0;
+    refusal.data = ENET_HOST_TO_NET_32 (ENET_PROTOCOL_REFUSED_OLDER_VERSION);
+
+    enet_protocol_send_outside_a_connection (host, command -> connect.outgoingPeerID, command -> connect.connectID, & refusal, sizeof (refusal));
+    ++ host -> olderConnectsRefused;
+}
