+namespace {
+
+/* Gets a folder from an environment variable, ready for looking up a settings
+ * file in it. An environment variable can hold anything, so the path is tidied
+ * up first (a part like "x/../" is worked out and removed) and it must be a
+ * complete path that starts at the top of the disk, the same rule used for the
+ * XDG folders below. A partial path would mean something different depending on
+ * the folder the program happens to be started from, so it is ignored. That is
+ * also what the XDG standard says to do with one. An unset variable or an
+ * ignored path gives back an empty path.
+ */
+auto GetEnvConfigDir(gsl::czstring const envname) -> fs::path
+{
+    auto dir = fs::path{};
+    if(auto value = al::getenv(envname))
+    {
+        dir = fs::path{*value}.lexically_normal();
+        if(!dir.is_absolute())
+        {
+            WARN("Ignoring {} dir: {}", envname, al::u8_as_char(dir.u8string()));
+            dir.clear();
+        }
+    }
+    return dir;
+}
+
+} // namespace
