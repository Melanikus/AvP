 auto lstrip(std::string &line) -> std::string&
 {
-    auto iter = std::ranges::find_if_not(line, [](const char c) { return std::isspace(c); });
+    /* The "is this a space?" check only accepts letters as numbers from 0 to
+     * 255. On Windows an accented letter in a settings file is stored as a
+     * negative number, which that check must never be given (a debug build
+     * stops with an error). as_unsigned turns it into its 0 to 255 value first.
+     */
+    auto iter = std::ranges::find_if_not(line,
+        [](const char c) { return std::isspace(as_unsigned(c)); });
     line.erase(line.begin(), iter);
     return line;
 }
