Check fopen and bound a buffer in libvorbis's disabled debug dumps.

Our own patch (AvP), for 6 Snyk Code findings in code that is only compiled
with TRAIN_FLOOR1, TRAIN_RES, TRAIN_RESAUX or ANALYSIS defined, which no normal
build does. A dump file that fails to open is skipped, and the dump's file name
can no longer run past its 80-byte buffer.

--- a/lib/analysis.c
+++ b/lib/analysis.c
@@ -71,10 +71,16 @@
   FILE *of;
   char buffer[80];
 
-  sprintf(buffer,"%s_%d.m",base,i);
+  /* buffer holds 80 bytes: snprintf cuts a longer name short instead of
+     writing past the end. */
+  snprintf(buffer,sizeof(buffer),"%s_%d.m",base,i);
   of=fopen(buffer,"w");
 
-  if(!of)perror("failed to open data dump file");
+  /* an optional debug dump: if the file cannot be opened, say so and skip it */
+  if(!of){
+    perror("failed to open data dump file");
+    return;
+  }
 
   for(j=0;j<n;j++){
     if(bark){
