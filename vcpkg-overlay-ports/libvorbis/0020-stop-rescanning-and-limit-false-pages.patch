+/* While a file is being opened, says whether it has had too many false pages.
+   skipped is the negative number ogg_sync_pageseek returned. A skip that starts
+   with "OggS" was a false page: it looked real, so all of it, up to about 64 KB,
+   was checksummed before it was thrown away. A crafted file can have one every
+   few bytes, and that is what makes such a file slow to open. Any other skip
+   costs almost nothing, so it is not counted. The count is in the first link's
+   setup because that lasts for the whole open. Once the limit is reached this
+   keeps saying yes, because not every caller stops at the first error. */
+static int _too_many_false_pages(OggVorbis_File *vf,long skipped){
+  codec_setup_info *ci=(vf->vi?vf->vi->codec_setup:NULL);
+
+  if(ci==NULL || ci->false_pages_left<0)return(0);
+  if(memcmp(vf->oy.data+vf->oy.returned+skipped,"OggS",4))return(0);
+  if(ci->false_pages_left==0)return(1);
+  ci->false_pages_left--;
+  return(0);
+}
+
+/* The file is open, or a new link of a stream has been read: stop counting. */
+static void _stop_counting_false_pages(OggVorbis_File *vf){
+  codec_setup_info *ci=(vf->vi?vf->vi->codec_setup:NULL);
+  if(ci)ci->false_pages_left=-1;
+}
