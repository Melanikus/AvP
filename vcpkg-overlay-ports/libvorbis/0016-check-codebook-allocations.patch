       ci->fullbooks=_ogg_calloc(ci->books,sizeof(*ci->fullbooks));
+      if(ci->fullbooks==NULL)goto abort_books;
       for(i=0;i<ci->books;i++){
         if(ci->book_param[i]==NULL)
           goto abort_books;
