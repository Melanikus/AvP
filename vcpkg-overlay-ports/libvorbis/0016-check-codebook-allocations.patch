Check the codebook allocations that upstream's fixes do not cover.

Our own patch (AvP). A crafted setup header can make these allocations fail: an
ordered book's size is not limited by the size of the packet. Upstream's main
limits that memory in its unreleased codebook rewrite (e99e46ed5c), which cannot
be taken on its own. Here, a failed allocation refuses the file instead of
writing through a null pointer.

--- a/lib/codebook.c
+++ b/lib/codebook.c
@@ -148,6 +148,7 @@
 static_codebook *vorbis_staticbook_unpack(oggpack_buffer *opb){
   long i,j;
   static_codebook *s=_ogg_calloc(1,sizeof(*s));
+  if(s==NULL)return(NULL);
   s->allocedp=1;
 
   /* make sure alignment is correct */
@@ -170,6 +171,7 @@
       goto _eofout;
     /* unordered */
     s->lengthlist=_ogg_malloc(sizeof(*s->lengthlist)*s->entries);
+    if(s->lengthlist==NULL)goto _errout;
 
     /* allocated but unused entries? */
     if(unused){
@@ -199,7 +201,12 @@
     {
       long length=oggpack_read(opb,5)+1;
       if(length==0)goto _eofout;
+      /* Unlike the unordered case above, this size is not limited by the
+         size of the packet: a few bytes of a crafted setup header can ask for
+         16 MB, and for up to 256 books. If the memory is not there, refuse
+         the file instead of writing through a null pointer. */
       s->lengthlist=_ogg_malloc(sizeof(*s->lengthlist)*s->entries);
+      if(s->lengthlist==NULL)goto _errout;
 
       for(i=0;i<s->entries;){
         long num=oggpack_read(opb,ov_ilog(s->entries-i));
@@ -263,6 +270,7 @@
       if(((quantvals*s->q_quant+7)>>3)>opb->storage-oggpack_bytes(opb))
         goto _eofout;
       s->quantlist=_ogg_malloc(sizeof(*s->quantlist)*quantvals);
+      if(s->quantlist==NULL)goto _errout;
       for(i=0;i<quantvals;i++)
         s->quantlist[i]=oggpack_read(opb,s->q_quant);
 
--- a/lib/sharedbook.c
+++ b/lib/sharedbook.c
@@ -214,6 +214,7 @@
     float mindel=_float32_unpack(b->q_min);
     float delta=_float32_unpack(b->q_delta);
     float *r=_ogg_calloc(n*b->dim,sizeof(*r));
+    if(r==NULL)return(NULL);
 
     /* maptype 1 and 2 both use a quantized value vector, but
        different sizes */
@@ -383,6 +384,9 @@
     _ogg_free(codes); codes=NULL;
 
     c->valuelist=_book_unquantize(s,n,sortindex);
+    /* a book with no value mapping has no values, so NULL is only an error
+       when it has one: the memory for them was not there */
+    if((s->maptype==1 || s->maptype==2) && c->valuelist==NULL)goto err_out;
     c->dec_index=_ogg_malloc(n*sizeof(*c->dec_index));
     if(c->dec_index==NULL)goto err_out;
 
